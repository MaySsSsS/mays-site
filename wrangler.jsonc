{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mays-site-web",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 线上固定用构建期快照：运行时再回源 game-api 会拖慢/挂住 Worker 渲染（曾导致 1101）。
  "vars": {
    "STEAM_DATA_SOURCE": "static"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mays-site-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}
