{
  "name": "mays-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:cf": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy": "node scripts/predeploy-check.mjs && pnpm build:cf && opennextjs-cloudflare deploy",
    "deploy:only": "node scripts/predeploy-check.mjs --skip-build && opennextjs-cloudflare deploy",
    "upload": "pnpm build:cf && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev:game-api": "pnpm --dir workers/game-api dev",
    "dev:photo-api": "pnpm --dir workers/photo-api dev",
    "test:idea-lab": "node --test scripts/idea-lab.test.mjs",
    "test:portal": "node --test scripts/portal-layout.test.mjs",
    "test:steam-assets": "node --test scripts/steam-assets.test.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "echarts": "^6.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "15.5.15",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zelda-hyrule-ui": "0.4.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.81.1"
  }
}
